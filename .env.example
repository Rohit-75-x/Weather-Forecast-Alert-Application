# Copy this file to .env and fill in your real API key.
# NEVER commit your actual .env file to GitHub!

# Get a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Mode: "simulation" (offline sample data) or "api" (live OpenWeatherMap API)
WEATHER_MODE=simulation

# Alert Thresholds
TEMP_HIGH_THRESHOLD=35.0
HUMIDITY_HIGH_THRESHOLD=80
WIND_HIGH_THRESHOLD=10.0
RAIN_PROB_THRESHOLD=60
AQI_HIGH_THRESHOLD=3
